{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "config/src/**/*.ts",
    "base/src/**/*.ts",
    "base/config/src/**/*.ts",
    "api/src/**/*.ts",
    "api/config/src/**/*.ts",
    "api/base/src/**/*.ts",
    "api/base/config/src/**/*.ts",
    "a11y/src/**/*.ts",
    "a11y/config/src/**/*.ts",
    "a11y/base/src/**/*.ts",
    "a11y/base/config/src/**/*.ts",
    "a11y/api/src/**/*.ts",
    "a11y/api/config/src/**/*.ts",
    "a11y/api/base/src/**/*.ts",
    "a11y/api/base/config/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "config/src/**/*.spec.ts",
    "config/src/**/*.test.ts",
    "base/src/**/*.spec.ts",
    "base/src/**/*.test.ts",
    "base/config/src/**/*.spec.ts",
    "base/config/src/**/*.test.ts",
    "api/src/**/*.spec.ts",
    "api/src/**/*.test.ts",
    "api/config/src/**/*.spec.ts",
    "api/config/src/**/*.test.ts",
    "api/base/src/**/*.spec.ts",
    "api/base/src/**/*.test.ts",
    "api/base/config/src/**/*.spec.ts",
    "api/base/config/src/**/*.test.ts",
    "a11y/src/**/*.spec.ts",
    "a11y/src/**/*.test.ts",
    "a11y/config/src/**/*.spec.ts",
    "a11y/config/src/**/*.test.ts",
    "a11y/base/src/**/*.spec.ts",
    "a11y/base/src/**/*.test.ts",
    "a11y/base/config/src/**/*.spec.ts",
    "a11y/base/config/src/**/*.test.ts",
    "a11y/api/src/**/*.spec.ts",
    "a11y/api/src/**/*.test.ts",
    "a11y/api/config/src/**/*.spec.ts",
    "a11y/api/config/src/**/*.test.ts",
    "a11y/api/base/src/**/*.spec.ts",
    "a11y/api/base/src/**/*.test.ts",
    "a11y/api/base/config/src/**/*.spec.ts",
    "a11y/api/base/config/src/**/*.test.ts"
  ]
}

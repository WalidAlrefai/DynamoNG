{
  "name": "theme-aura",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/theme/presets/aura/src",
  "projectType": "library",
  "tags": ["type:theme", "scope:public"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/theme/presets/aura",
        "main": "libs/theme/presets/aura/src/index.ts",
        "tsConfig": "libs/theme/presets/aura/tsconfig.lib.json",
        "assets": ["libs/theme/presets/aura/*.md"]
      }
    },
    "build-css": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": ["default", "{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/libs/theme/tokens/src/**/*.ts"],
      "outputs": ["{workspaceRoot}/dist/libs/theme/presets/aura/theme.css"],
      "options": {
        "command": "node --require @swc-node/register libs/theme/presets/aura/scripts/build-theme-css.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}

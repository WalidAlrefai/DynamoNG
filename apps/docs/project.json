{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "docs",
  "sourceRoot": "apps/docs/src",
  "tags": ["type:app"],
  "targets": {
    "docs-api": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/libs/components/forms/checkbox/src/**/*.ts",
        "{workspaceRoot}/libs/components/forms/radio/src/**/*.ts",
        "{workspaceRoot}/libs/components/forms/switch/src/**/*.ts",
        "{workspaceRoot}/libs/components/forms/textarea/src/**/*.ts",
        "{workspaceRoot}/libs/core/api/src/**/*.ts"
      ],
      "outputs": [
        "{workspaceRoot}/apps/docs/src/app/generated/api/checkbox.json",
        "{workspaceRoot}/apps/docs/src/app/generated/api/radio.json",
        "{workspaceRoot}/apps/docs/src/app/generated/api/switch.json",
        "{workspaceRoot}/apps/docs/src/app/generated/api/textarea.json"
      ],
      "options": {
        "command": "node --require @swc-node/register tools/typedoc/generate-api-docs.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "dependsOn": ["docs-api"],
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/docs",
        "browser": "apps/docs/src/main.ts",
        "tsConfig": "apps/docs/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/docs/public"
          }
        ],
        "styles": [
          "node_modules/@angular/cdk/overlay-prebuilt.css",
          "apps/docs/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "dependsOn": ["docs-api"],
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "docs:build:production"
        },
        "development": {
          "buildTarget": "docs:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "dependsOn": ["docs-api"],
      "options": {
        "watch": false,
        "coverage": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "docs:build",
        "staticFilePath": "dist/apps/docs/browser",
        "spa": true
      }
    }
  }
}
